        equipmentId: '',
        date: TODAY,
        shift: 'Manhã',
        startTime: '08:00',
        endTime: '11:45',
        room: '',
        professor: 'Você (Professor Atual)',
        cbType: 'carrinho',
        cbQuantity: 36
      });
      const [bookingSuccessMsg, setBookingSuccessMsg] = useState(null);

      // Reservas ativas hoje pertencentes ao usuário logado
      const todayActiveReservations = useMemo(() => {
        return reservations.filter(r => r.date === TODAY && r.status === 'confirmed' && r.professor.includes('Você'));
      }, [reservations]);

      // Função de Verificação de Conflitos (Core Engine)
      const checkConflict = (equipId, date, shift, startTime, endTime, excludeResId = null) => {
        return reservations.find(res => {
          if (res.id === excludeResId || res.status === 'cancelled') return false;
          if (res.equipmentId === equipId && res.date === date) {
            // Conflito por período de turno idêntico ou sobreposição direta
            if (res.shift === shift) return true;
            // Se horários colidirem diretamente
            if (startTime < res.endTime && endTime > res.startTime) return true;
          }
          return false;
        });
      };

      // Handler para Agendar via UI
      const handleCreateBooking = (e) => {
        e.preventDefault();
        if (!bookingForm.equipmentId || !bookingForm.room || !bookingForm.date) {
          alert('Por favor, selecione o equipamento, informe a sala/local e a data.');
          return;
        }

        const conflict = checkConflict(
          bookingForm.equipmentId,
          bookingForm.date,
          bookingForm.shift,
          bookingForm.startTime,
          bookingForm.endTime
        );

        if (conflict) {
          alert(`⚠️ CONFLITO DE HORÁRIO DETECTADO!\n\nEste recurso já está reservado por "${conflict.professor}" para a ${conflict.room} no mesmo turno/horário (${conflict.shift} - ${conflict.startTime} às ${conflict.endTime}).\n\nPor favor, escolha outro equipamento equivalente ou outro horário.`);
          return;
        }

        const equip = equipments.find(i => i.id === bookingForm.equipmentId);
        const newBooking = {
          id: `RES-${Math.floor(1000 + Math.random() * 9000)}`,
          equipmentId: equip.id,
          equipmentName: equip.name,
          date: bookingForm.date,
          shift: bookingForm.shift,
          startTime: bookingForm.startTime,
          endTime: bookingForm.endTime,
          room: bookingForm.room,
          professor: bookingForm.professor,
          status: 'confirmed',
          createdAt: 'Agora'
        };

        setReservations(prev => [newBooking, ...prev]);
        setBookingSuccessMsg(`Reserva ${newBooking.id} confirmada com sucesso para ${equip.name}!`);
        setTimeout(() => setBookingSuccessMsg(null), 5000);

        // Reset sala
        setBookingForm(prev => ({ ...prev, room: '' }));
        setCurrentTab('my-reservations');
      };

      // Handler para Cancelamento
      const handleCancelReservation = (id) => {
        if (confirm('Deseja realmente liberar este equipamento e cancelar sua reserva?')) {
          setReservations(prev => prev.map(r => r.id === id ? { ...r, status: 'cancelled' } : r));
        }
      };

      // Iniciar reserva a partir de um card do catálogo
      const startBookingFromCatalog = (equipId) => {
        setBookingForm(prev => ({ ...prev, equipmentId }));
        setCurrentTab('booking');
      };

      // --- MOTOR DO TECHBOT (Chatbot com Tool Emulation) ---
      const handleSendBotMessage = (e) => {
        e.preventDefault();
        const text = botInput.trim();
        if (!text) return;

        // Adiciona mensagem do usuário
        const newHistory = [...botMessages, { role: 'user', text }];
        setBotMessages(newHistory);
        setBotInput('');

        // Processamento baseado nas regras do TechBot
        setTimeout(() => {
          processBotResponse(text.toLowerCase(), newHistory);
        }, 600);
      };

      const processBotResponse = (userQuery, history) => {
        let reply = "";
        let data = { ...botPendingData };

        // 1. Detecção de confirmação final ("sim", "pode", "confirmo")
        if ((userQuery.includes('sim') || userQuery.includes('pode') || userQuery.includes('confirma') || userQuery.includes('positivo')) && data.readyToBook) {
          // Tool Trigger: criar_agendamento
          const equip = equipments.find(i => i.id === data.equipId) || equipments[0];
          const newId = `RES-${Math.floor(1000 + Math.random() * 9000)}`;
          
          setReservations(prev => [{
            id: newId,
            equipmentId: equip.id,
            equipmentName: equip.name,
            date: data.date || TODAY,
            shift: data.shift || 'Manhã',
            startTime: data.startTime || '08:00',
            endTime: data.endTime || '11:45',
            room: data.room || 'Sala solicitada',
            professor: 'Você (Via TechBot)',
            status: 'confirmed',
            createdAt: 'Agora'
          }, ...prev]);

          reply = `✅ [Ferramenta criar_agendamento executada] Reserva registrada com sucesso! Seu código é ${newId}. O equipamento ${equip.name} estará pronto na ${data.room}. Mais alguma coisa em que posso ajudar?`;
          setBotPendingData({});
          setBotMessages(prev => [...prev, { role: 'assistant', text: reply }]);
          return;
        }

        // 2. Extração de Equipamento
        if (userQuery.includes('chromebook') || userQuery.includes('chrome')) {
          data.equipCategory = 'chromebooks';
          if (!data.chromebookType) {
            reply = "Para os Chromebooks: você precisa do 'carrinho completo' (36 unidades) ou de 'unidades individuais'? Qual a quantidade?";
            data.step = 'awaiting_cb_type';
            setBotPendingData(data);
            setBotMessages(prev => [...prev, { role: 'assistant', text: reply }]);
            return;
          }
        } else if (userQuery.includes('tv') || userQuery.includes('televis')) {
          data.equipId = 'tv-55';
          data.equipName = 'Smart TV 55" Móvel LG';
        } else if (userQuery.includes('projetor') || userQuery.includes('epson')) {
          data.equipId = 'proj-epson';
          data.equipName = 'Projetor Epson Laser';
        } else if (userQuery.includes('caixa') || userQuery.includes('som') || userQuery.includes('jbl')) {
          data.equipId = 'audio-jbl';
          data.equipName = 'Caixa de Som JBL EON';
        } else if (userQuery.includes('cabo') || userQuery.includes('adaptador') || userQuery.includes('passador')) {
          data.equipId = 'kit-hdmi';
          data.equipName = 'Kit Adaptadores & Passador HDMI';
        }

        // Se estava aguardando tipo de Chromebook
        if (data.step === 'awaiting_cb_type') {
          if (userQuery.includes('carrinho')) {
            data.equipId = 'cb-01';
            data.equipName = 'Carrinho de Chromebooks 01';
            data.chromebookType = 'carrinho';
          } else {
            data.equipId = 'cb-ind-01';
            data.equipName = 'Chromebooks Individuais';
            data.chromebookType = 'individual';
          }
          data.step = null;
        }

        // 3. Extração de Local / Sala (Regra Mandatória)
        const matchRoom = userQuery.match(/(sala\s*\d+|audit[óo]rio|laborat[óo]rio\s*\d*|bloco\s*[a-z]|lab\s*\d*)/i);
        if (matchRoom) {
          data.room = matchRoom[0].toUpperCase();
        }

        // 4. Data e Turno
        if (userQuery.includes('amanhã')) {
          const tom = new Date();
          tom.setDate(tom.getDate() + 1);
          data.date = tom.toISOString().split('T')[0];
        } else if (userQuery.includes('hoje')) {
          data.date = TODAY;
        }

        if (userQuery.includes('manhã') || userQuery.includes('manha')) {
          data.shift = 'Manhã';
          data.startTime = '08:00';
          data.endTime = '11:45';
        } else if (userQuery.includes('tarde')) {
          data.shift = 'Tarde';
          data.startTime = '13:30';
          data.endTime = '17:15';
        } else if (userQuery.includes('noite')) {
          data.shift = 'Noite';
          data.startTime = '19:00';
          data.endTime = '22:00';
        }

        // Validação de Etapas Faltantes
        if (!data.equipId) {
          reply = "Qual equipamento multimídia você gostaria de reservar? Temos Carrinhos de Chromebooks, Smart TVs móveis, Projetores Laser, Caixas de Som e Kits de Cabos/Adaptadores.";
        } else if (!data.room) {
          reply = `Entendido! Você escolheu ${data.equipName || 'o equipamento'}. Como nossos equipamentos são móveis, em qual sala ou ambiente você irá utilizá-lo? (Ex: Sala 202, Auditório)`;
        } else if (!data.shift || !data.date) {
          reply = `Perfeito para a ${data.room}. Para qual data e turno você precisa? (Ex: Hoje à Tarde, ou Amanhã pela Manhã)`;
        } else {
          // Tool Trigger: consultar_disponibilidade
          const conflict = checkConflict(data.equipId, data.date, data.shift, data.startTime, data.endTime);
          
          if (conflict) {
            // Resolução de Conflitos: propor alternativa
            let alternative = null;
            if (data.equipId === 'cb-01') alternative = 'Carrinho de Chromebooks 02';
            else if (data.equipId === 'tv-55') alternative = 'Smart TV 65" Móvel Samsung';

            if (alternative) {
              reply = `⚠️ [Tool consultar_disponibilidade]: O equipamento ${data.equipName} já está alocado para ${conflict.room} no turno da ${data.shift}. Verifiquei e temos disponível o "${alternative}". Deseja que eu agende este alternativo para a ${data.room}?`;
              data.equipId = alternative.includes('02') ? 'cb-02' : 'tv-65';
              data.equipName = alternative;
            } else {
              reply = `⚠️ [Tool consultar_disponibilidade]: Não há unidades livres de ${data.equipName} no turno da ${data.shift} para o dia ${data.date}. Poderia ser em outro turno (Tarde ou Noite)?`;
            }
          } else {
            // Resumo e Validação Final
            data.readyToBook = true;
            reply = `🔍 [Tool consultar_disponibilidade]: Equipamento 100% disponível!\n\nConfirmando: ${data.equipName} para a ${data.room} no dia ${data.date} (${data.shift} - das ${data.startTime} às ${data.endTime}). Posso registrar? (Responda "Sim" para confirmar)`;
          }
        }

        setBotPendingData(data);
        setBotMessages(prev => [...prev, { role: 'assistant', text: reply }]);
      };

      // Filtro de catálogo
      const filteredEquipments = useMemo(() => {
        return equipments.filter(item => {
          const matchCat = selectedCategory === 'all' || item.category === selectedCategory;
          const matchQuery = item.name.toLowerCase().includes(filterSearch.toLowerCase()) || 
                             item.specs.toLowerCase().includes(filterSearch.toLowerCase());
          return matchCat && matchQuery;
        });
      }, [equipments, selectedCategory, filterSearch]);

      return (
        <div className="min-h-screen flex flex-col bg-slate-50">
          
