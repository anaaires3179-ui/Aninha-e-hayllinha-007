                              {res.status === 'confirmed' ? 'Confirmado' : 'Cancelado'}
                            </span>
                            {res.date === TODAY && res.status === 'confirmed' && (
                              <span className="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded uppercase">
                                Hoje
                              </span>
                            )}
                          </div>

                          <h3 className="font-bold text-slate-800 text-base">{res.equipmentName}</h3>
                          
                          <div className="flex flex-wrap items-center gap-y-1 gap-x-4 text-xs text-slate-500 pt-1">
                            <span className="flex items-center gap-1">
                              <strong>Data:</strong> {res.date}
                            </span>
                            <span className="flex items-center gap-1">
                              <strong>Turno:</strong> {res.shift} ({res.startTime} - {res.endTime})
                            </span>
                            <span className="flex items-center gap-1 text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                              📍 <strong>Local:</strong> {res.room}
                            </span>
                            <span>
                              <strong>Solicitante:</strong> {res.professor}
                            </span>
                          </div>
                        </div>

                        {res.status === 'confirmed' && (
                          <div className="flex items-center gap-2">
                            <button
                              onClick={() => handleCancelReservation(res.id)}
                              className="text-xs font-semibold text-red-600 hover:text-red-800 border border-red-200 hover:border-red-400 bg-red-50 hover:bg-red-100 px-3.5 py-2 rounded-lg transition"
                            >
                              Cancelar Reserva
                            </button>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}

              </div>
            )}

          </main>

          {/* ============================================================ */}
          {/* DRAWER / MODAL TECHBOT ASSISTANT */}
          {/* ============================================================ */}
          {isBotOpen && (
            <div className="fixed inset-0 z-50 flex justify-end bg-black/40 backdrop-blur-sm">
              <div className="w-full max-w-md bg-white h-full flex flex-col shadow-2xl animate-slide-left">
                
                {/* Topo do Chat */}
                <div className="bg-brand-navy p-4 text-white flex items-center justify-between border-b border-slate-700">
                  <div className="flex items-center gap-3">
                    <div className="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center text-white">
                      <Icons.Bot />
                    </div>
                    <div>
                      <h3 className="font-bold text-sm text-white">TechBot Multimídia</h3>
                      <p className="text-[11px] text-emerald-400 flex items-center gap-1">
                        <span className="w-2 h-2 rounded-full bg-emerald-400"></span> Assistente Ativo & Online
                      </p>
                    </div>
                  </div>
                  <button 
                    onClick={() => setIsBotOpen(false)}
                    className="text-slate-400 hover:text-white p-1 rounded"
                  >
                    <Icons.Close />
                  </button>
                </div>

                {/* Área de Mensagens */}
                <div className="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50 text-sm custom-scrollbar">
                  {botMessages.map((msg, idx) => (
                    <div
                      key={idx}
                      className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}
                    >
                      <div
                        className={`max-w-[85%] rounded-2xl px-4 py-2.5 shadow-sm text-xs sm:text-sm whitespace-pre-line leading-relaxed ${
                          msg.role === 'user'
                            ? 'bg-blue-600 text-white rounded-br-none'
                            : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none'
                        }`}
                      >
                        {msg.text}
                      </div>
                    </div>
                  ))}
                </div>

                {/* Sugestões rápidas de prompt */}
                <div className="p-2 bg-slate-100 border-t border-slate-200 flex gap-2 overflow-x-auto text-[11px] custom-scrollbar">
                  <button 
                    onClick={() => setBotInput('Preciso de uma Smart TV para a Sala 202 hoje à tarde')}
                    className="whitespace-nowrap bg-white hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded border border-slate-300"
                  >
                    TV para Sala 202 à tarde
                  </button>
                  <button 
                    onClick={() => setBotInput('Gostaria de agendar 30 chromebooks para o Laboratório')}
                    className="whitespace-nowrap bg-white hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded border border-slate-300"
                  >
                    Chromebooks p/ Laboratório
                  </button>
                </div>

                {/* Input do Chat */}
                <form onSubmit={handleSendBotMessage} className="p-3 bg-white border-t border-slate-200 flex gap-2">
                  <input
                    type="text"
                    value={botInput}
                    onChange={(e) => setBotInput(e.target.value)}
                    placeholder="Ex: Preciso de um projetor na Sala 104 hoje..."
                    className="flex-1 px-3.5 py-2 text-xs sm:text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                  <button
                    type="submit"
                    className="bg-brand-navy hover:bg-slate-800 text-white px-3.5 py-2 rounded-lg flex items-center justify-center transition"
                  >
                    <Icons.Send />
                  </button>
                </form>

              </div>
            </div>
          )}

          {/* RODAPÉ INSTITUCIONAL */}
          <footer className="bg-white border-t border-slate-200 text-slate-500 text-xs py-4 px-6 text-center">
            <p>Sistema Institucional de Gestão e Reserva de Multimídias • Desenvolvido para Alta Disponibilidade Educacional</p>
          </footer>

        </div>
      );
    }

    // RENDERIZAÇÃO
    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
Destaques de Arquitetura e Engenharia de UI/UX
Dashboard & Notificação de Reserva Ativa Hoje:
Um banner superior dinâmico consulta em tempo real o dia atual (TODAY). Se o usuário possuir alocações para o dia, ele é destacado com status pulsante e atalho para gerenciamento.
Prevenção de Choques de Horário (Anti-Conflict Engine):
A função checkConflict() atua antes de qualquer gravação de reserva. Ela analisa tanto a data quanto a colisão de turnos (Manhã, Tarde, Noite) e horários numéricos (startTime e endTime), impedindo reservas simultâneas e alertando visualmente o usuário.
Catálogo Integrado:
Organizado exatamente nas quatro categorias solicitadas: Chromebooks, TVs e Monitores, Projeção e Áudio e Cabos e Acessórios.
O botão "Reservar este Item" já pré-preenche o formulário de agendamento automaticamente, reduzindo os cliques do professor.
TechBot Integrado com Gatilhos de Ferramentas:
O assistente virtual flutuante segue à risca o fluxo especificado:
Sempre pergunta a sala/local.
Para Chromebooks, discrimina entre carrinho completo (36 unidades) ou unidades individuais.
Aciona o simulador da tool consultar_disponibilidade.
Se houver choque, sugere ativamente uma máquina idêntica (ex.: sugerir Carrinho 02 se o Carrinho 01 estiver alocado).
Apresenta o resumo textual formal e, ao receber o aval do usuário ("Sim"), executa a tool criar_agendamento e insere o registro diretamente na base de dados ativa da aplicação.
